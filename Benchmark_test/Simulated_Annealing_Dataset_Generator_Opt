from qiskit import QuantumCircuit
from qiskit.circuit.random import random_circuit
from Simulated_Annealing import optimize_circuit_with_simulated_annealing
import json
import os

def convert_qiskit_to_gate_sequence(circ):
    gate_sequence = []
    for instr in circ.data:
        gate = instr.operation.name
        qubit_indices = [circ.qubits.index(q) for q in instr.qubits]
        params = instr.operation.params
        gate_sequence.append({"name": gate, "qubits": qubit_indices, "params": params})
    return gate_sequence

def generate_and_save_data(output_path, num_circuits=100, num_qubits=4, depth=10):
    os.makedirs(output_path, exist_ok=True)
    for i in range(num_circuits):
        orig_circuit = random_circuit(num_qubits, depth, max_operands=2)
        opt_circuit = optimize_circuit_with_simulated_annealing(orig_circuit)

        data = {
            "original": convert_qiskit_to_gate_sequence(orig_circuit),
            "optimized": convert_qiskit_to_gate_sequence(opt_circuit),
        }

        filename = os.path.join(output_path, f"circuit_{i:03d}.json")
        with open(filename, "w") as f:
            json.dump(data, f, indent=2)

        print(f"Saved {filename}")

if __name__ == "__main__":
    generate_and_save_data("output_sa_dataset", num_circuits=10, num_qubits=4, depth=10)
